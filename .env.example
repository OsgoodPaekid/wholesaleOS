# Direct (non-pooled) connection — used ONLY by Prisma CLI for migrations & seeding.
DIRECT_URL="postgresql://neondb_owner:npg_R5UusIjD1ypz@ep-hidden-silence-ax92p1jr.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

